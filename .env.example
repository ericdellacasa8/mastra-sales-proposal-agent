# Offline deterministic previews and unit tests need no API keys.
# Copy this file to .env for conversational Mastra Studio functionality.
# The configured model provider receives conversation and proposal content.
OPENAI_API_KEY=
MODEL=openai/gpt-5-mini

# Absolute override recommended. Default resolves from module/project location, never cwd.
# Existing legacy Studio workspace is reused in place; see README before migration.
# PROPOSAL_DATA_DIR=/absolute/private/path/sales-proposal-data
# CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
# PROPOSAL_PREVIEW_ORIGIN=http://localhost:4111

# Disable Mastra CLI/Studio analytics for local development.
MASTRA_TELEMETRY_DISABLED=true
